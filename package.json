{
  "name": "checkion-v3",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @checkion-v3/contracts && npm run build -w web",
    "test": "npm run test -w web",
    "typecheck": "npm run typecheck -w web",
    "dev": "npm run dev -w web",
    "db:push": "npm run db:push -w web",
    "mcp:build": "npm run build --prefix mcp-server",
    "mcp:dev": "npm run dev --prefix mcp-server"
  }
}
